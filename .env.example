ANALYST_NAME=

# ---------------------------------------------------------------------------
# Free keys. Get these first - they unlock most of the platform.
# ---------------------------------------------------------------------------

# One key covers ThreatFox, URLhaus and MalwareBazaar
# Sign up: https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# Campaign reporting and pulses
# Sign up: https://otx.alienvault.com  ->  Settings  ->  API Integration
OTX_API_KEY=

# Optional. Raises the NVD rate limit from 5 to 50 requests per 30s.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ---------------------------------------------------------------------------
# Paid. Everything else works without these.
# ---------------------------------------------------------------------------

# Used ONLY for aggregate country-level counts. No host lists are retrieved.
SHODAN_API_KEY=
